.classList.add('active');btn.setAttribute('aria-selected','true');parent.querySelectorAll('.surfdoc-tab-content').forEach(tc=>{if(tc.dataset.tab===tab){tc.classList.add('active');tc.style.display='block'}else{tc.classList.remove('active');tc.style.display='none'}})}})})</script><div class="surfdoc-tab-content active" data-tab="library" role="tabpanel" style="max-width:700px;margin-left:auto;margin-right:auto;width:100%"><p>Ruled centered column: full-bleed on mobile, 700 on tablet, 880 on desktop.</p>
