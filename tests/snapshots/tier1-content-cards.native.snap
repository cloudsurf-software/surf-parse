[
  {
    "type": "markdown",
    "content": "# Content cards\n\nA corpus fixture exercising the reader-content blocks that render\nstructurally on native (A-04 / BR-APP-7): product-card, chart, row,\ninfo-card, and diagram. Before A-04 these degraded to a markdown\nstring on native; this fixture pins the structural native projection."
  },
  {
    "type": "product_card",
    "title": "Surf Pro",
    "subtitle": "For growing teams",
    "badge": "Popular",
    "badge_color": "green",
    "body": "Everything in Free, plus unlimited workspaces and priority Mako.",
    "features": [
      "Unlimited workspaces",
      "Priority Mako routing",
      "Shared conversation history"
    ],
    "cta_label": "Start free trial",
    "cta_href": "/pricing/pro"
  },
  {
    "type": "chart",
    "chart_type": "line",
    "source": "/api/metrics/wau",
    "period": "weekly"
  },
  {
    "type": "chart",
    "chart_type": "bar",
    "source": "/api/metrics/revenue",
    "period": null
  },
  {
    "type": "row",
    "icon": "doc",
    "title": "Getting started",
    "description": "Read the five-minute intro guide",
    "href": "/docs/getting-started",
    "state": "default",
    "actions": []
  },
  {
    "type": "row",
    "icon": "clock",
    "title": "Syncing",
    "description": "Fetching the latest activity",
    "href": null,
    "state": "loading",
    "actions": []
  },
  {
    "type": "row",
    "icon": "doc",
    "title": "Jordan Lee",
    "description": "@jordan wants to connect",
    "href": null,
    "state": "default",
    "actions": [
      {
        "label": "Accept",
        "action": {
          "verb": "invoke",
          "target": "contacts.accept",
          "payload": null,
          "raw": "invoke:contacts.accept"
        }
      },
      {
        "label": "Deny",
        "action": {
          "verb": "mutate",
          "target": "contacts.deny",
          "payload": "id",
          "raw": "mutate:contacts.deny:id"
        }
      }
    ]
  },
  {
    "type": "info_card",
    "intent": "success",
    "title": "Acme onboarding",
    "subtitle": "New customer setup",
    "summary": "Walk through the first-run checklist to get the workspace ready.",
    "image": "/img/onboard.png",
    "facts": [],
    "steps": [
      "Create a workspace",
      "Invite your teammates",
      "Connect a repository"
    ],
    "state": "default"
  },
  {
