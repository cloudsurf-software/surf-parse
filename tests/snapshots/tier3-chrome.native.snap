[
  {
    "type": "app_shell",
    "layout": "sidebar",
    "children": [
      {
        "type": "sidebar",
        "position": "left",
        "collapsible": true,
        "width": 240,
        "children": [
          {
            "type": "nav_tree",
            "source": "files",
            "on_select": {
              "verb": "invoke",
              "target": "open_file",
              "payload": null,
              "raw": "open_file"
            },
            "on_rename": null,
            "on_delete": null
          }
        ]
      },
      {
        "type": "toolbar",
        "title": "Messages",
        "title_source": "thread.display_name",
        "items": [
          {
            "kind": "button",
            "label": "Run",
            "action": {
              "verb": "invoke",
              "target": "run",
              "payload": null,
              "raw": "run"
            },
            "icon": "play",
            "style": "primary",
            "disabled": false,
            "value": null,
            "color": null,
            "options": null
          },
          {
            "kind": "separator",
            "label": null,
            "action": null,
            "icon": null,
            "style": null,
            "disabled": false,
            "value": null,
            "color": null,
            "options": null
          },
          {
            "kind": "badge",
            "label": null,
            "action": null,
            "icon": null,
            "style": null,
            "disabled": false,
            "value": "Live",
            "color": "green",
            "options": null
          }
        ]
      },
      {
        "type": "tab_bar",
        "active": "preview",
        "items": [
          {
            "id": "preview",
            "label": "Preview",
            "icon": "eye"
          },
          {
            "id": "edit",
            "label": "Edit",
            "icon": "pencil"
          }
        ]
      },
      {
        "type": "tab_content",
        "tab": "preview",
        "children": [
          {
            "type": "markdown",
            "content": "Preview pane content."
          }
        ]
      },
      {
        "type": "tab_content",
        "tab": "edit",
        "children": [
          {
            "type": "code_editor",
            "lang": "surf",
            "source": "doc",
            "line_numbers": true,
            "content": "# Editable doc"
          }
        ]
      },
      {
        "type": "panel",
        "position": "bottom",
        "resizable": false,
        "height": 160,
        "desktop_only": true,
        "children": [
          {
            "type": "problem_list",
            "source": "diagnostics"
          }
        ]
      }
    ]
  },
  {
    "type": "drawer",
    "name": "filters",
    "position": "right",
    "width": 320,
    "trigger": "Filters",
    "children": [
      {
        "type": "markdown",
        "content": "Drawer body content."
      }
    ]
  },
  {
    "type": "modal",
    "name": "confirm",
    "title": "Confirm shipment",
    "children": [
      {
        "type": "markdown",
        "content": "Are you sure you want to ship?"
      }
    ]
  },
  {
    "type": "command_palette",
    "trigger": "cmd+k",
    "items": [
      {
        "label": "Deploy",
        "description": "Ship to production",
        "action": {
          "verb": "invoke",
          "target": "deploy",
          "payload": null,
          "raw": "deploy"
        },
        "icon": "paperplane",
        "group": "Ops"
      },
      {
        "label": "Toggle theme",
        "description": null,
        "action": {
          "verb": "invoke",
          "target": "theme",
          "payload": null,
          "raw": "theme"
        },
        "icon": "moon",
        "group": "View"
      }
    ]
  },
  {
    "type": "badge",
    "value": "3",
    "color": "red"
  },
  {
    "type": "suggestion_chips",
    "source": "ai.suggestions",
    "max": 3,
    "dismissible": true
  },
  {
    "type": "chat_thread",
    "source": "chat.thread",
    "on_action": {
      "verb": "invoke",
      "target": "run_action",
      "payload": null,
      "raw": "run_action"
    },
    "on_react": {
      "verb": "mutate",
      "target": "messages.react",
      "payload": "emoji",
      "raw": "mutate:messages.react:emoji"
    },
    "on_doc_open": {
      "verb": "open",
      "target": "/docs/{id}",
      "payload": null,
      "raw": "open:/docs/{id}"
    }
  },
  {
    "type": "chat_input_simple",
    "placeholder": "Ask Mako…",
    "action": {
      "verb": "invoke",
      "target": "send",
      "payload": null,
      "raw": "send"
    }
  },
  {
    "type": "progress",
    "source": "deploy.progress",
    "steps": [
      {
        "label": "Parse",
        "status": "done"
      },
      {
        "label": "Build",
        "status": "active"
      },
      {
        "label": "Ship",
        "status": "pending"
      }
    ]
  },
  {
    "type": "log_stream",
    "source": "build.log",
    "tail": 100
  },
  {
    "type": "terminal",
    "shell": "zsh",
    "cwd": "~/code"
  },
  {
    "type": "block_editor",
    "source": "doc"
  }
]