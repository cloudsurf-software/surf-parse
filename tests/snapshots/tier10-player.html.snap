;var playing=status==='playing',loading=status==='loading',errored=status==='errored';ui.barTitle.textContent=t.title;ui.barArtist.textContent=errored?'Unable to play':t.artist;art(ui.barArt,ui.barImg,t);art(ui.sheetArt,ui.sheetImg,t);ui.sheetTitle.textContent=t.title;ui.sheetSub.textContent=errored?'Unable to play':(t.artist+(t.album?' · '+t.album:''));ui.expand.setAttribute('aria-label','Now playing: '+t.title+(t.artist?' by '+t.artist:'')+'. Show full player');ui.toggles.forEach(function(b){b.classList.toggle('is-playing',playing);b.classList.toggle('is-loading',loading);b.disabled=loading||errored;b.setAttribute('aria-label',(playing?'Pause ':'Play ')+t.title);if(loading)b.setAttribute('aria-busy','true');else b.removeAttribute('aria-busy')});ui.shuffle.setAttribute('aria-pressed',shuffle?'true':'false');ui.shuffle.classList.toggle('is-active',shuffle);var d=isFinite(audio.duration)?audio.duration:0;ui.scrub.max=d||0;ui.scrub.disabled=errored||!d;ui.total.textContent=d?fmt(d):(t.duration||'-:--');ui.scrub.setAttribute('aria-label','Seek within '+t.title);onTime();if('mediaSession' in navigator){try{navigator.mediaSession.playbackState=playing?'playing':'paused'}catch(e){}}}function onTime(){if(!bar)return;var d=isFinite(audio.duration)?audio.duration:0,c=audio.currentTime||0,pct=d>0?(c/d*100):0;bar.style.setProperty('--surfdoc-progress',pct+'%');ui.scrub.style.setProperty('--surfdoc-progress',pct+'%');if(doc.activeElement!==ui.scrub)ui.scrub.value=c;ui.elapsed.textContent=fmt(c);ui.scrub.setAttribute('aria-valuetext',fmt(c)+' of '+(d?fmt(d):'unknown'));if('mediaSession' in navigator&&navigator.mediaSession.setPositionState&&d>0&&isFinite(c)){try{navigator.mediaSession.setPositionState({duration:d,position:Math.min(c,d),playbackRate:1})}catch(e){}}}function play(t){justEnded=false;if(t.src!==currentSrc){audio.src=t.src;audio.currentTime=0;currentSrc=t.src;status='loading';render()}var p=audio.play();if(p&&p.then)p.then(function(){status='playing';render()},function(){status='errored';render()});if('mediaSession' in navigator&&window.MediaMetadata){try{navigator.mediaSession.metadata=new MediaMetadata({title:t.title,artist:t.artist,album:t.album,artwork:t.art?[{src:t.art,sizes:'512x512'}]:[]})}catch(e){}}}function playByIndex(i){if(i<0||i>=queue.length)return;index=i;chrome();play(queue[i])}function playQueue(q,i){if(!q.length)return;queue=q;shuffleQueue=[];history=[];playByIndex(Math.min(Math.max(i||0,0),q.length-1))}function toggleTrack(t){var c=current();if(c&&c.id===t.id){toggle();return}playQueue(t.queue,t.queue.indexOf(t))}function toggle(){var c=current();if(!c)return;if(status==='playing'){audio.pause();return}play(c)}function next(){var c=current();if(!c){return}if(shuffle){history.push(c.id);if(!shuffleQueue.length){shuffleQueue=shuffled(queue.map(function(t){return t.id}).filter(function(id){return id!==c.id}))}var nid=shuffleQueue.shift(),ni=-1;queue.forEach(function(t,i){if(t.id===nid)ni=i});if(ni<0){close();return}playByIndex(ni);return}if(index>=queue.length-1){close();return}playByIndex(index+1)}function previous(){var c=current();if(!c)return;if(audio.currentTime>3){seek(0);return}if(shuffle){var pid=history.pop(),pi=-1;queue.forEach(function(t,i){if(t.id===pid)pi=i});if(pi<0){seek(0);return}playByIndex(pi);return}if(index<=0){seek(0);return}playByIndex(index-1)}function seek(s){audio.currentTime=s;onTime()}function setShuffle(b){shuffle=!!b;shuffleQueue=[];history=[];render()}function close(){audio.pause();index=-1;shuffleQueue=[];history=[];collapse();if('mediaSession' in navigator){try{navigator.mediaSession.playbackState='none';navigator.mediaSession.metadata=null}catch(e){}}render()}function lockScroll(on){var b=doc.body;if(on){if(lock)return;var g=window.innerWidth-doc.documentElement.clientWidth;lock={o:b.style.overflow,p:b.style.paddingRight};b.style.overflow='hidden';if(g>0){b.style.paddingRight=((parseFloat(getComputedStyle(b).paddingRight)||0)+g)+'px'}}else if(lock){b.style.overflow=lock.o;b.style