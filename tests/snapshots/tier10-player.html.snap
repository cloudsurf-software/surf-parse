<section class="surfdoc-player surfdoc-player-row" data-player="" data-layout="row" data-album="Time Traveler" data-artist="Scouter" data-buy="/music/time-traveler#buy"><span class="surfdoc-player-art" data-art-missing=""></span><button type="button" class="surfdoc-player-track surfdoc-player-now" data-src="/audio/time-traveler.mp3" data-title="Time Traveler" data-duration="2:54" aria-label="Play Time Traveler"><span class="surfdoc-player-glyph" aria-hidden="true"></span></button><span class="surfdoc-player-main"><span class="surfdoc-player-title">Time Traveler · Scouter</span><span class="surfdoc-player-line">The title track streams free. The record is $9.99.</span></span><span class="surfdoc-player-time">2:54</span><a class="surfdoc-player-buy-btn" href="/music/time-traveler#buy">Buy the album</a></section><script>(function(){if(window.__surfdocPlayer)return;var doc=document,sections=[].slice.call(doc.querySelectorAll('.surfdoc-player[data-player]'));if(!sections.length)return;var P=window.__surfdocPlayer={};var audio=doc.createElement('audio');audio.preload='none';audio.setAttribute('aria-hidden','true');var queue=[],index=-1,shuffle=false,shuffleQueue=[],history=[],status='idle',currentSrc=null,justEnded=false,expanded=false,tracks=[];var bar=null,sheet=null,backdrop=null,ui={},drag=null,lock=null,focusBack=null;function fmt(s){if(!isFinite(s)||s<0)return '0:00';var m=Math.floor(s/60),x=Math.floor(s%60);return m+':'+(x<10?'0':'')+x}function reduced(){try{return !!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)}catch(e){return false}}function coarse(){try{return !!(window.matchMedia&&matchMedia('(pointer: coarse)').matches)}catch(e){return false}}function shuffled(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}sections.forEach(function(s,si){var rows=[].slice.call(s.querySelectorAll('.surfdoc-player-track[data-src]'));var q=[];rows.forEach(function(r){if(!r.dataset.sr