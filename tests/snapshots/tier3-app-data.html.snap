<div class="surfdoc-search" data-surf-source="/api/search"><input type="search" placeholder="Search docs…" aria-label="Search docs…" autocomplete="off"/><div class="surfdoc-search-results" aria-live="polite"></div></div>
<div class="surfdoc-filter-bar" data-surf-target="#tasks"><label class="surfdoc-filter-field">Status<select name="status"><option value="All">All</option><option value="To Do">To Do</option><option value="In Progress">In Progress</option><option value="Done">Done</option></select></label><label class="surfdoc-filter-field">Priority<select name="priority"><option value="All">All</option><option value="Low">Low</option><option value="Medium">Medium</option><option value="High">High</option></select></label></div>
<div class="surfdoc-list surfdoc-list-card" data-surf-source="/api/tasks" data-surf-preload data-surf-sort="created_at" data-surf-sort-dir="desc"><div class="surfdoc-list-filters"><label class="surfdoc-list-filter">status</label><label class="surfdoc-list-filter">assignee</label></div><template class="surfdoc-list-item-template">## {= title =}
{= summary =}</template><div class="surfdoc-list-items" aria-live="polite"><div class="surfdoc-list-item surfdoc-list-item-sample"><strong class="surfdoc-list-item-title">Design API schema</strong><span class="surfdoc-list-item-meta">Status: In Progress &middot; Assigned: Taylor</span></div><div class="surfdoc-list-item surfdoc-list-item-sample"><strong class="surfdoc-list-item-title">Write integration tests</strong><span class="surfdoc-list-item-meta">Status: Todo &middot; Assigned: Alex</span></div><div class="surfdoc-list-item surfdoc-list-item-sample"><strong class="surfdoc-list-item-title">Deploy to staging</strong><span class="surfdoc-list-item-meta">Status: Done &middot; Assigned: Jordan</span></div></div></div>
<div class="surfdoc-list surfdoc-list-compact" data-surf-source="/api/docs"><template class="surfdoc-list-item-template">{= title =}</template><div class="surfdoc-list-items" aria-live="polite"><div class="surfdoc-list-item surfdoc-list-item-sample"><strong class="surfdoc-list-item-title">Design API schema</strong><span class="surfdoc-list-item-meta">Status: In Progress &middot; Assigned: Taylor</span></div><div class="surfdoc-list-item surfdoc-list-item-sample"><strong class="surfdoc-list-item-title">Write integration tests</strong><span class="surfdoc-list-item-meta">Status: Todo &middot; Assigned: Alex</span></div><div class="surfdoc-list-item surfdoc-list-item-sample"><strong class="surfdoc-list-item-title">Deploy to staging</strong><span class="surfdoc-list-item-meta">Status: Done &middot; Assigned: Jordan</span></div></div></div>
<div class="surfdoc-board surfdoc-board-preview" data-surf-source="/api/tasks/board" data-surf-preload><div class="surfdoc-board-columns"><div class="surfdoc-board-column" data-column="To Do"><h3 class="surfdoc-board-column-title">To Do</h3><div class="surfdoc-board-cards" aria-live="polite"><div class="surfdoc-board-card surfdoc-board-card-sample">Design API schema</div><div class="surfdoc-board-card surfdoc-board-card-sample">Write integration tests</div></div></div><div class="surfdoc-board-column" data-column="In Progress"><h3 class="surfdoc-board-column-title">In Progress</h3><div class="surfdoc-board-cards" aria-live="polite"><div class="surfdoc-board-card surfdoc-board-card-sample">Build board renderer</div></div></div><div class="surfdoc-board-column" data-column="Done"><h3 class="surfdoc-board-column-title">Done</h3><div class="surfdoc-board-cards" aria-live="polite"><div class="surfdoc-board-card surfdoc-board-card-sample">Set up CI/CD</div><div class="surfdoc-board-card surfdoc-board-card-sample">Deploy to staging</div></div></div></div></div>