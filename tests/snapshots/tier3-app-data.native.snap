[
  {
    "type": "search",
    "source": "/api/search",
    "placeholder": "Search docs…"
  },
  {
    "type": "filter_bar",
    "target_selector": "#tasks",
    "fields": [
      {
        "label": "Status",
        "name": "status",
        "options": [
          "All",
          "To Do",
          "In Progress",
          "Done"
        ]
      },
      {
        "label": "Priority",
        "name": "priority",
        "options": [
          "All",
          "Low",
          "Medium",
          "High"
        ]
      }
    ]
  },
  {
    "type": "list",
    "source": "/api/tasks",
    "display": "card",
    "item_template": "## {= title =}\n{= summary =}",
    "filters": [
      "status",
      "assignee"
    ],
    "sort_field": "created_at",
    "sort_descending": true,
    "preload": true,
    "stream": null,
    "on_select": null
  },
  {
    "type": "list",
    "source": "/api/docs",
    "display": "compact",
    "item_template": "{= title =}",
    "filters": [],
    "sort_field": null,
    "sort_descending": false,
    "preload": false,
    "stream": null,
    "on_select": null
  },
  {
    "type": "list",
    "source": "conversations",
    "display": "compact",
    "item_template": "{= display_name =}",
    "filters": [],
    "sort_field": null,
    "sort_descending": false,
    "preload": false,
    "stream": "conversation_updated",
    "on_select": {
      "verb": "invoke",
      "target": "openThread",
      "payload": null,
      "raw": "openThread"
    }
  },
  {
    "type": "search",
    "source": "userSearch",
    "placeholder": "Search by username"
  },
  {
    "type": "recipient_picker",
    "source": "contacts",
    "mode": "multi",
    "on_submit": {
      "verb": "invoke",
      "target": "messages.compose",
      "payload": null,
      "raw": "invoke:messages.compose"
    }
  },
  {
    "type": "qr",
    "mode": "show",
    "on_resolve": null
  },
  {
    "type": "qr",
    "mode": "scan",
    "on_resolve": {
      "verb": "invoke",
      "target": "contacts.add",
      "payload": null,
      "raw": "invoke:contacts.add"
    }
  },
  {
    "type": "board",
    "source": "/api/tasks/board",
    "columns": [
      "To Do",
      "In Progress",
      "Done"
    ],
    "card_template": null,
    "preload": true
  }
]