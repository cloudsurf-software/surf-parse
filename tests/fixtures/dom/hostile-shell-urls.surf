::app-shell[name=shell-urls layout=sidebar-main-panel height=720]

:::sidebar[position=left width=240]

::::row[icon=doc action=openDocs href="javascript:alert('sidebar')"]
JS href row
::::

::::row[icon=apps href="data:text/html,%3Cscript%3Ex%3C/script%3E" avatar="javascript:alert('avatar')"]
Data href row with a hostile avatar
::::

::::row[icon=user href="JaVaScRiPt:alert(2)" avatar=group]
Mixed-case scheme row
::::

::::row[icon=login href="vbscript:msgbox" trailing-label="Go" trailing-action="javascript:alert('trailing')"]
Trailing control with a hostile action
::::

:::

:::toolbar
- button[label="Hub" avatar="data:image/svg+xml,%3Csvg onload=alert(1)%3E" action="javascript:alert('btn')"]
- spacer
- button[icon=plus action=compose aria-label="New"]
:::

:::tab-content[tab=main]

::::form[submit="Search" action="javascript:alert('form')" method=get]
- Search (text, "Search mail")
::::

::::form[submit="Post" action="data:text/html,%3Cscript%3Ex%3C/script%3E" method=post]
- Name (text, "Name") *
::::

::::embed[src="javascript:alert('embed')" type=generic height=480px title="JS body"]
::::

::::embed[src="data:text/html,%3Cscript%3Ex%3C/script%3E" type=generic height=200px title="Data body"]
::::

::::embed[src="/email/thread-id/body?q=a&b='q'" type=generic height=240px title="Ampersand body"]
::::

::::row[icon=doc href=#]
Markdown links inside a chrome row
[js link](javascript:alert(1)) and [data link](data:text/html,%3Cscript%3Ex%3C/script%3E)
::::

